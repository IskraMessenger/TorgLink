<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>$(NetCoreTargetFramework)</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TorgLink.Web.Api</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NLog" Version="5.3.4" />
    <PackageReference Include="NLog.Extensions.Logging" Version="5.3.11" />
    <PackageReference Include="SQLitePCLRaw.bundle_green" Version="2.1.11" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.13" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\BotHostClaims.cs" Link="Services\BotHostClaims.cs" />
    <Compile Include="..\Shared\LoRa\LoRaTransportSettings.cs" Link="LoRa\LoRaTransportSettings.cs" />
    <Compile Include="..\Shared\LoRa\LoRaTransportSettingsStore.cs" Link="LoRa\LoRaTransportSettingsStore.cs" />
    <Compile Include="..\Shared\LoRa\LoRaMeshPeerInfo.cs" Link="LoRa\LoRaMeshPeerInfo.cs" />
    <Compile Include="..\Shared\LoRa\MeshtasticTransportHost.cs" Link="LoRa\MeshtasticTransportHost.cs" />
    <Compile Include="..\Shared\LoRa\LoRaBootstrap.cs" Link="LoRa\LoRaBootstrap.cs" />
    <ProjectReference Include="..\..\ShortP2P\src\ShortP2P.Auth\ShortP2P.Auth.csproj" />
    <ProjectReference Include="..\..\ShortP2P\src\ShortP2P.Client\ShortP2P.Client.csproj" />
    <ProjectReference Include="..\..\ShortP2P\src\ShortP2P.Discovery\ShortP2P.Discovery.csproj" />
    <ProjectReference Include="..\..\ShortP2P\src\ShortP2P.TrustSystem\ShortP2P.TrustSystem.csproj" />
    <ProjectReference Include="..\..\ShortP2P.LoRa\src\ShortP2P.LoRa\ShortP2P.LoRa.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="nlog.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

</Project>
