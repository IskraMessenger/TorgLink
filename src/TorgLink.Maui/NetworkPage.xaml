<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:TorgLink.Maui"
             x:Class="TorgLink.Maui.NetworkPage"
             Title="Network"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{DynamicResource PageBackground}">
    <ScrollView>
        <VerticalStackLayout Spacing="14" Padding="0,0,0,20">
            <local:AppHeaderView x:Name="Header" />
            <Grid Margin="16,4" ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10"
                  RowSpacing="10">
                <Button x:Name="AddChatButton" Clicked="OnAddChatClicked" Style="{StaticResource NetworkTile}" />
                <Button x:Name="MyQrButton" Grid.Column="1" Clicked="OnMyQrClicked"
                        Style="{StaticResource NetworkTile}" />
                <Button x:Name="MyAddressesButton" Grid.Column="2" Clicked="OnMyAddressesClicked"
                        Style="{StaticResource NetworkTile}" />
                <Button x:Name="CopyKeyButton" Grid.Row="1" Clicked="OnCopyKeysClicked"
                        Style="{StaticResource NetworkTile}" />
                <Button x:Name="LanScanButton" Grid.Row="1" Grid.Column="1" Clicked="OnLanScanClicked"
                        Style="{StaticResource NetworkTile}" />
                <Button x:Name="RoutingButton" Grid.Row="1" Grid.Column="2" Clicked="OnRoutingClicked"
                        Style="{StaticResource NetworkTile}" />
            </Grid>
            <Button x:Name="ServersButton" Clicked="OnServersClicked" Margin="16,0"
                    BackgroundColor="{DynamicResource Accent}" TextColor="{DynamicResource ButtonText}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
